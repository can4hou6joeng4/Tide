# Minimal local config
# 完整 Cookie（name=value; name2=value2）或裸 sessionid 值均可，脚本会自动补齐前缀
JUEJIN_COOKIE=

# Optional: enable Telegram notification
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional: send to a Telegram topic
# TELEGRAM_MESSAGE_THREAD_ID=

# Optional: override the default browser User-Agent
# JUEJIN_USER_AGENT=

# Optional: true/false, local default is false (headed mode is easier to debug)
# GitHub Actions runs with JUEJIN_HEADLESS=true
# JUEJIN_HEADLESS=false
